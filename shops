local function C_6()
local script = G2L["6"];
	-- LocalScript (inside your TextButton)
	
	-- Get a reference to the button itself
	local button = script.Parent
	
	-- Connect a function to the MouseButton1Click event (fires when the button is clicked)
	button.MouseButton1Click:Connect(function()
		print("Button was clicked! (Client-side message)") 
		-- Client-side teleport script to Diango (Shop) (Model)
		local player = game.Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local hrp = character:WaitForChild("HumanoidRootPart") -- Player's HumanoidRootPart
	
		-- Target shop model
		local shopModel = workspace:WaitForChild("NPCs"):WaitForChild("Shops"):WaitForChild("Diango (Shop)")
	
		-- Find a valid part to teleport to
		local targetPart = shopModel.PrimaryPart or shopModel:FindFirstChild("HumanoidRootPart") or shopModel:FindFirstChildWhichIsA("BasePart")
	
		-- Teleport
		if targetPart then
			hrp.CFrame = targetPart.CFrame + Vector3.new(0, 5, 0) -- Teleport 5 studs above the part
		else
			warn("No valid part found in Diango (Shop) model!")
		end
	
	end)
end;
