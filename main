-- Workspace.tlon hub.Frame.Frame.Player Header.Fly.LocalScript
local function C_10()
local script = G2L["10"];
	-- LocalScript (inside your TextButton)
	
	-- Get a reference to the button itself
	local button = script.Parent
	
	-- Connect a function to the MouseButton1Click event (fires when the button is clicked)
	button.MouseButton1Click:Connect(function()
		print("Button was clicked! (Client-side message)") 
		--// Services
		local Players = game:GetService("Players")
		local UserInputService = game:GetService("UserInputService")
		local RunService = game:GetService("RunService")
	
		local player = Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
		local humanoid = character:WaitForChild("Humanoid")
	
		--// Fly settings
		local flying = false
		local speed = 50 -- studs per second
		local velocity = Vector3.new()
		local keys = {W = false, A = false, S = false, D = false}
	
		--// Toggle fly with "K"
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == Enum.KeyCode.K then
				flying = not flying
				if flying then
					humanoid.PlatformStand = true -- disables default Roblox physics
				else
					humanoid.PlatformStand = false
				end
			end
	
			-- Track movement keys
			if input.KeyCode == Enum.KeyCode.W then keys.W = true end
			if input.KeyCode == Enum.KeyCode.A then keys.A = true end
			if input.KeyCode == Enum.KeyCode.S then keys.S = true end
			if input.KeyCode == Enum.KeyCode.D then keys.D = true end
		end)
	
		UserInputService.InputEnded:Connect(function(input, gameProcessed)
			if input.KeyCode == Enum.KeyCode.W then keys.W = false end
			if input.KeyCode == Enum.KeyCode.A then keys.A = false end
			if input.KeyCode == Enum.KeyCode.S then keys.S = false end
			if input.KeyCode == Enum.KeyCode.D then keys.D = false end
		end)
	
		--// Fly loop
		RunService.RenderStepped:Connect(function(delta)
			if flying then
				local camCFrame = workspace.CurrentCamera.CFrame
				local moveDir = Vector3.new()
	
				if keys.W then moveDir = moveDir + camCFrame.LookVector end
				if keys.S then moveDir = moveDir - camCFrame.LookVector end
				if keys.A then moveDir = moveDir - camCFrame.RightVector end
				if keys.D then moveDir = moveDir + camCFrame.RightVector end
	
				if moveDir.Magnitude > 0 then
					moveDir = moveDir.Unit
				end
	
				velocity = moveDir * speed
				humanoidRootPart.Velocity = Vector3.new(velocity.X, velocity.Y, velocity.Z)
			else
				humanoidRootPart.Velocity = Vector3.new(0, humanoidRootPart.Velocity.Y, 0)
			end
		end)
	
	end)
end;
task.spawn(C_10);
-- Workspace.tlon hub.Frame.Frame.Player Header.No Clip.LocalScript
local function C_13()
local script = G2L["13"];
	-- LocalScript (inside your TextButton)
	
	-- Get a reference to the button itself
	local button = script.Parent
	
	-- Connect a function to the MouseButton1Click event (fires when the button is clicked)
	button.MouseButton1Click:Connect(function()
		print("Button was clicked! (Client-side message)") 
		--// Services
		local Players = game:GetService("Players")
		local UserInputService = game:GetService("UserInputService")
	
		local player = Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid")
	
		local noclipEnabled = false
	
		--// Toggle noclip with "N"
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == Enum.KeyCode.N then
				noclipEnabled = not noclipEnabled
				if noclipEnabled then
					print("Noclip Enabled")
				else
					print("Noclip Disabled")
				end
			end
		end)
	
		--// Noclip loop
		game:GetService("RunService").Stepped:Connect(function()
			if noclipEnabled then
				for _, part in ipairs(character:GetChildren()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			else
				for _, part in ipairs(character:GetChildren()) do
					if part:IsA("BasePart") then
						part.CanCollide = true
					end
				end
			end
		end)
	
	end)
end;
task.spawn(C_13);
-- Workspace.tlon hub.Frame.Frame.Player Header.Walkspeed.LocalScript
local function C_16()
local script = G2L["16"];
	-- LocalScript (inside your TextButton)
	
	-- Get a reference to the button itself
	local button = script.Parent
	
	-- Connect a function to the MouseButton1Click event (fires when the button is clicked)
	button.MouseButton1Click:Connect(function()
		print("Button was clicked! (Client-side message)") 
		--// Services
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		local UserInputService = game:GetService("UserInputService")
	
		local player = Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
	
		local walkSpeed = 75
		local moveKeys = {W=false, A=false, S=false, D=false}
	
		--// Track movement keys
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == Enum.KeyCode.W then moveKeys.W = true end
			if input.KeyCode == Enum.KeyCode.A then moveKeys.A = true end
			if input.KeyCode == Enum.KeyCode.S then moveKeys.S = true end
			if input.KeyCode == Enum.KeyCode.D then moveKeys.D = true end
		end)
	
		UserInputService.InputEnded:Connect(function(input, gameProcessed)
			if input.KeyCode == Enum.KeyCode.W then moveKeys.W = false end
			if input.KeyCode == Enum.KeyCode.A then moveKeys.A = false end
			if input.KeyCode == Enum.KeyCode.S then moveKeys.S = false end
			if input.KeyCode == Enum.KeyCode.D then moveKeys.D = false end
		end)
	
		--// Force velocity each frame
		RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			local moveDir = Vector3.new()
	
			if moveKeys.W then moveDir += cam.CFrame.LookVector end
			if moveKeys.S then moveDir -= cam.CFrame.LookVector end
			if moveKeys.A then moveDir -= cam.CFrame.RightVector end
			if moveKeys.D then moveDir += cam.CFrame.RightVector end
	
			if moveDir.Magnitude > 0 then
				moveDir = moveDir.Unit * walkSpeed
				humanoidRootPart.Velocity = Vector3.new(moveDir.X, humanoidRootPart.Velocity.Y, moveDir.Z)
			else
				humanoidRootPart.Velocity = Vector3.new(0, humanoidRootPart.Velocity.Y, 0)
			end
		end)
	
	end)
end;
task.spawn(C_16);
-- Workspace.tlon hub.Frame.Frame.Autofarm header.Champions Arena.LocalScript
local function C_1a()
local script = G2L["1a"];
	-- LocalScript (inside your TextButton)
	
	-- Get a reference to the button itself
	local button = script.Parent
	
	-- Connect a function to the MouseButton1Click event (fires when the button is clicked)
	button.MouseButton1Click:Connect(function()
		print("Button was clicked! (Client-side message)") 
		-- Stable Client-side Autofarm Script (Frozen Tween + Stand Behind + Auto Attack)
		local Players = game:GetService("Players")
		local TweenService = game:GetService("TweenService")
		local UserInputService = game:GetService("UserInputService")
	
		local player = Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local hrp = character:WaitForChild("HumanoidRootPart")
		local backpack = player:WaitForChild("Backpack")
	
		-- Autofarm toggle
		local autofarmEnabled = false
		local toggleKey = Enum.KeyCode.F
	
		-- Toggle autofarm with F
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == toggleKey then
				autofarmEnabled = not autofarmEnabled
				print("Autofarm toggled:", autofarmEnabled)
			end
		end)
	
		-- Function to get all valid boss models in ChampionsArena
		local function getBosses()
			local arena = workspace:WaitForChild("Game Mobs"):WaitForChild("ChampionsArena")
			local bosses = {}
			for _, child in ipairs(arena:GetChildren()) do
				if child:IsA("Model") then
					table.insert(bosses, child)
				end
			end
			return bosses
		end
	
		-- Get a valid part inside a model
		local function getBossPart(model)
			return model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
		end
	
		-- Smoothly teleport behind boss while frozen
		local function teleportBehindFrozen(bossPart)
			-- Freeze player
			hrp.Anchored = true
	
			-- Calculate position 2 studs behind boss, looking at boss
			local offset = -bossPart.CFrame.LookVector * 2
			local targetCFrame = CFrame.new(bossPart.Position + offset, bossPart.Position)
	
			-- Tween to position
			local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Linear)
			local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
			tween:Play()
			tween.Completed:Wait()
	
			-- Unfreeze player
			hrp.Anchored = false
		end
	
		-- Auto attack function
		local function autoAttack()
			local tool = character:FindFirstChildWhichIsA("Tool") or backpack:FindFirstChildWhichIsA("Tool")
			if tool and tool:FindFirstChild("Handle") then
				if tool.Parent == backpack then
					tool.Parent = character
				end
				tool:Activate()
			end
		end
	
		-- Autofarm loop
		spawn(function()
			while true do
				if autofarmEnabled then
					local bosses = getBosses()
					for _, bossModel in ipairs(bosses) do
						local bossPart = getBossPart(bossModel)
						if bossPart then
							teleportBehindFrozen(bossPart) -- Smooth frozen teleport
							autoAttack()                   -- Auto attack
							wait(0.5)                       -- Wait before next boss
						end
					end
				else
					wait(0.5)
				end
				wait(0.1)
			end
		end)
	
	end)
end;
task.spawn(C_1a);
-- Workspace.tlon hub.Frame.Frame.Autofarm header.Tharinian Dark Sea.LocalScript
local function C_1d()
local script = G2L["1d"];
	-- LocalScript (inside your TextButton)
	
	-- Get a reference to the button itself
	local button = script.Parent
	
	-- Connect a function to the MouseButton1Click event (fires when the button is clicked)
	button.MouseButton1Click:Connect(function()
		print("Button was clicked! (Client-side message)") 
		-- Client-side Auto Farm Script
		-- Auto farm + stand behind mobs + autoclicker + tool attack + proper camera
		-- Toggle Key: G
		-- Run in a LocalScript
	
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		local TweenService = game:GetService("TweenService")
		local UserInputService = game:GetService("UserInputService")
		local LocalPlayer = Players.LocalPlayer
		local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
		local Humanoid = Character:WaitForChild("Humanoid")
		local Tool = nil
	
		-- Settings
		local attackDistance = 10        -- Distance to start attacking
		local tweenSpeed = 25            -- Speed for teleport
		local freezeDuringTween = true
		local behindDistance = 2         -- Distance behind mob
		local clickRate = 10             -- Autoclicker speed (clicks per second)
	
		-- Toggle
		local autoFarm = false
		local toggleKey = Enum.KeyCode.G
	
		-- Hardcoded mob list
		local mobs = {
			workspace["Game Mobs"].Tharinian2:GetChildren()[5],
			workspace["Game Mobs"].Tharinian2.Marauder,
			workspace["Game Mobs"].Tharinian2:GetChildren()[2],
			workspace["Game Mobs"].Tharinian2:GetChildren()[3],
			workspace["Game Mobs"].Tharinian2:GetChildren()[4]
		}
	
		-- Freeze/unfreeze player
		local function setFreeze(state)
			Humanoid.PlatformStand = state
		end
	
		-- Get position directly behind mob
		local function getPositionBehindMob(mob)
			local mobHRP = mob:FindFirstChild("HumanoidRootPart")
			if not mobHRP then return HumanoidRootPart.Position end
			local behindPos = mobHRP.Position - (mobHRP.CFrame.LookVector * behindDistance)
			behindPos = Vector3.new(behindPos.X, HumanoidRootPart.Position.Y, behindPos.Z)
			return behindPos
		end
	
		-- Tween to target position without changing rotation
		local function tweenTo(targetPos)
			if not HumanoidRootPart or not targetPos then return end
			local distance = (HumanoidRootPart.Position - targetPos).Magnitude
			local duration = distance / tweenSpeed
			local currentCFrame = HumanoidRootPart.CFrame
			local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
			local tweenGoal = {CFrame = CFrame.new(targetPos) * CFrame.Angles(currentCFrame:ToEulerAnglesXYZ())}
			local tween = TweenService:Create(HumanoidRootPart, tweenInfo, tweenGoal)
	
			if freezeDuringTween then setFreeze(true) end
			tween:Play()
			tween.Completed:Wait()
			if freezeDuringTween then setFreeze(false) end
		end
	
		-- Face the mob
		local function faceMob(mob)
			local mobHRP = mob:FindFirstChild("HumanoidRootPart")
			if mobHRP then
				HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position, Vector3.new(mobHRP.Position.X, HumanoidRootPart.Position.Y, mobHRP.Position.Z))
			end
		end
	
		-- Find tool in character
		local function findTool()
			if Tool and Tool.Parent then return Tool end
			for _, item in pairs(Character:GetChildren()) do
				if item:IsA("Tool") then
					Tool = item
					return Tool
				end
			end
			return nil
		end
	
		-- Autoclicker attack
		local function autoClickTool(mob)
			local tool = findTool()
			if not tool or not mob or not mob:FindFirstChild("Humanoid") then return end
			if tool:FindFirstChild("Handle") then
				tool:Activate() -- simulates a click
			end
		end
	
		-- Toggle keybind
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == toggleKey then
				autoFarm = not autoFarm
				print("Auto Farm toggled:", autoFarm and "ON" or "OFF")
			end
		end)
	
		-- Main Auto Farm Loop
		spawn(function()
			while true do
				if autoFarm then
					for _, mob in ipairs(mobs) do
						if not autoFarm then break end
						if mob and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") then
							local mobHRP = mob.HumanoidRootPart
							local mobHumanoid = mob.Humanoid
	
							-- Move behind mob
							local targetPos = getPositionBehindMob(mob)
							tweenTo(targetPos)
	
							-- While near mob, face and attack using autoclicker
							while mobHumanoid and mobHumanoid.Health > 0 and autoFarm and (HumanoidRootPart.Position - mobHRP.Position).Magnitude <= attackDistance + behindDistance do
								faceMob(mob)
								autoClickTool(mob)
								wait(1 / clickRate) -- controls autoclicker speed
							end
						end
					end
				else
					wait(0.5)
				end
			end
		end)
	
	end)
end;
task.spawn(C_1d);
